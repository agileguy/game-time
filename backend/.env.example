# Application
APP_NAME=Game Time
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://gametime_user:gametime_pass@localhost:5432/gametime
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Security
SESSION_EXPIRE_HOURS=24
ROOM_CODE_LENGTH=4
ROOM_TIMEOUT_HOURS=1

# Rate Limiting
ENABLE_RATE_LIMITING=True
RATE_LIMIT_ROOM_CREATION=5  # per hour per IP
RATE_LIMIT_API_REQUESTS=100  # per minute per IP
RATE_LIMIT_WS_MESSAGES=60  # per minute per connection

# Game Settings
MAX_PLAYERS_PER_ROOM=12
MIN_PLAYERS_PER_ROOM=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Testing
TESTING=False
